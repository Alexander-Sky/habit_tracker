# Скопируйте этот файл в .env и заполните значения:
#   cp .env.template .env
# Файл .env в репозиторий не попадает.
#
# Значения ниже рассчитаны на запуск через Docker Compose: имена db и redis —
# это имена сервисов из docker-compose.yaml, внутри сети Docker они
# работают как адреса. Как запустить проект без Docker — написано в README,
# там же сказано, что поменять в этом файле.
#
# Этот же файл читает сам docker-compose: из него он берёт DB_NAME,
# DB_USER и DB_PASSWORD, чтобы создать базу с такими параметрами.

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=Europe/Vienna

# --- База данных ---
# PostgreSQL поднимается контейнером db, ставить её на компьютер не нужно
DB_ENGINE=django.db.backends.postgresql
DB_NAME=habit_tracker
DB_USER=habit_tracker
DB_PASSWORD=habit_tracker_local_password
DB_HOST=db
DB_PORT=5432

# --- CORS ---
# Домены фронтенда через запятую
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=1

# --- Celery и Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Telegram ---
# Токен выдаёт @BotFather после команды /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org/bot
# Сколько ждать ответа от Telegram, секунд
TELEGRAM_TIMEOUT_SECONDS=30

# Окно в минутах, в течение которого напоминание ещё считается актуальным,
# если воркер был занят и не успел отправить вовремя
REMINDER_WINDOW_MINUTES=5

# --- Только для сервера ---
# WEB_IMAGE — тег образа из GHCR, который запускает docker-compose.prod.yaml.
# В боевой .env эту строку дописывает GitHub Actions при деплое, руками
# её заполнять не нужно:
# WEB_IMAGE=ghcr.io/alexander-sky/habit_tracker:latest
