# Скопируйте этот файл в .env и заполните значения:
#   cp .env.template .env
# Файл .env в репозиторий не попадает.

# --- Django ---
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Vienna

# --- База данных ---
# По умолчанию SQLite, отдельная установка не нужна.
# Для PostgreSQL раскомментируйте и заполните:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=habit_tracker
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- CORS ---
# Домены фронтенда через запятую
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=1

# --- Celery и Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Telegram ---
# Токен выдаёт @BotFather после команды /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org/bot
# Сколько ждать ответа от Telegram, секунд
TELEGRAM_TIMEOUT_SECONDS=30

# Окно в минутах, в течение которого напоминание ещё считается актуальным,
# если воркер был занят и не успел отправить вовремя
REMINDER_WINDOW_MINUTES=5
