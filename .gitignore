# Секреты
# Закрываем .env и всё, что от него произошло: .env.old, .env.backup,
# .env.production. Перечислять по одному ненадёжно — резервную копию
# называют как придётся, а попасть в git ей достаточно одного раза
.env
.env.*
# Кроме шаблона: в нём нет значений, только имена переменных
!.env.template

# Медиа и статика
media/
staticfiles/

